{
  // The CommonJS build (supabase auth-js layout): dist/main. tsconfig.module.json
  // builds the same sources again into dist/module.
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "outDir": "dist/main",
    "rootDir": "src",
  },
  "include": ["src"]
}
