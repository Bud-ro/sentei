{
  "name": "sentei",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Org-wide dead export detection",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "sentei": "packages/cli/src/main.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "sentei": "node packages/cli/src/main.ts",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen:scip": "buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
